+void MCurlHttpClient::markBodyDone(MCurlResponseBody *body) {
+  {
+    // Set done_ while holding both mutexes that guard the waits on it (read() waits on
+    // streamCV_ under streamMutex_, waitForDone() on doneCV_ under doneMutex_). Without the
+    // locks a notification sent between a waiter's predicate check and its sleep is lost and
+    // the waiter never wakes up: the reader thread hangs forever after the transfer finished.
+    std::lock_guard<std::mutex> streamLock(body->streamMutex_);
+    std::lock_guard<std::mutex> doneLock(body->doneMutex_);
+    body->done_ = true;
+  }
+  body->streamCV_.notify_all();
+  body->doneCV_.notify_all();
+}
